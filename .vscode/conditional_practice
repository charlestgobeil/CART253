"use strict";
let creature = {
    x: 100,
    y: 100,
    w: 120,
    h: 120,

    eye: {
        fill: "#f8f8f8",
        size: 40,
        centerx: 100,
        centery: 100,

    },
    fillstates: {
        happy: "#f2f231",
        angry: "#f23131",
        sad: "#3134f2",
        neutral: "#eee6b3"

    },
    neutralfill: "#eee6b3"
}


/**
 * OH LOOK I DIDN'T DESCRIBE SETUP!!
*/
function setup() {
    createCanvas(500, 500);

}


/**
 * OOPS I DIDN'T DESCRIBE WHAT MY DRAW DOES!
*/
function draw() {

    let distance = dist(creature.x, creature.y, mouseX, mouseY)
    let mouseIsMoving = (movedX > 0 || movedY > 0)
    if (distance < creature.w / 2 && mouseIsMoving === true) {
        creature.neutralfill = creature.fillstates.angry;
    }


    if (mouseIsPressed === true) {
        creature.neutralfill = creature.fillstates.angry;
    }
    else if (keyIsPressed === true) {
        creature.neutralfill = creature.fillstates.happy;
    }
    else {
        creature.neutralfill = creature.fillstates.neutral;
    }



    background(0);
    push();
    //body
    fill(creature.neutralfill)
    ellipse(creature.x, creature.y, creature.w, creature.h)

    fill(creature.eye.fill)
    //left eye
    ellipse(creature.eye.centerx - creature.eye.size, creature.eye.centery, creature.eye.size, creature.eye.size)
    //right eye
    ellipse(creature.eye.centerx + creature.eye.size, creature.eye.centery, creature.eye.size, creature.eye.size)
    pop();

}